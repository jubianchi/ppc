{
    "name": "jubianchi/ppc",
    "description": "A parser combinator library for PHP",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.4",
        "phpunit/php-invoker": "^7.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "infection/infection": "^0.35.8",
        "phpmetrics/phpmetrics": "^2.11",
        "parsica-php/parsica": "^0.8.3"
    },
    "autoload": {
        "psr-4": {
            "jubianchi\\PPC\\": ["src/lib"],
            "jubianchi\\PPC\\Parsers\\": ["parsers"]
        },
        "files": [
            "src/parsers.php",
            "src/combinators.php",
            "src/debug.php",
            "src/mappers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "jubianchi\\PPC\\Benchmarks\\": ["benchmarks"],
            "jubianchi\\PPC\\Tests\\": ["tests/unit"],
            "jubianchi\\PPC\\Tests\\Parsers\\": ["tests/unit/parsers"],
            "jubianchi\\PPC\\Tests\\Combinators\\": ["tests/unit/combinators"]
        },
        "files": [
            "parsers/json.php"
        ]
    },
    "scripts": {
        "bm": "phpbench run --report=aggregate --ansi",
        "bm:ref": "phpbench run --report=aggregate --tag=reference --ansi",
        "bmc": "phpbench run --report=aggregate --ref=reference --ansi",
        "cs": "php-cs-fixer fix --ansi --allow-risky=yes",
        "mt": "infection --ansi --no-progress --threads=max",
        "sa": "phpstan analyse --ansi --memory-limit=1G",
        "pm": "phpunit --testdox && phpmetrics --config=phpmetrics.json",
        "ut": "phpunit --testdox",
        "dev:docs": [
            "Composer\\Config::disableProcessTimeout",
            "cd docs && ../node_modules/.bin/docsify serve"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
