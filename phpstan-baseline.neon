parameters:
	ignoreErrors:
		-
			message: '#^Cannot use array destructuring on mixed\.$#'
			identifier: offsetAccess.nonArray
			count: 1
			path: parsers/json.php

		-
			message: '#^Binary operation "\." between ''\['' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/lib/Logger/CLI.php

		-
			message: '#^Binary operation "\." between non\-falsy\-string and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/lib/Logger/CLI.php

		-
			message: '#^Method jubianchi\\PPC\\Logger\\CLI\:\:log\(\) has parameter \$message with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/lib/Logger/CLI.php

		-
			message: '#^Parameter \#1 \$level of closure expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/lib/Logger/CLI.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\:\:do\(\) should return \$this\(jubianchi\\PPC\\Parser\) but returns static\(jubianchi\\PPC\\Parser\)\.$#'
			identifier: return.type
			count: 1
			path: src/lib/Parser.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\:\:map\(\) should return \$this\(jubianchi\\PPC\\Parser\) but returns static\(jubianchi\\PPC\\Parser\)\.$#'
			identifier: return.type
			count: 1
			path: src/lib/Parser.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\:\:stringify\(\) should return \$this\(jubianchi\\PPC\\Parser\) but returns static\(jubianchi\\PPC\\Parser\)\.$#'
			identifier: return.type
			count: 1
			path: src/lib/Parser.php

		-
			message: '#^Only booleans are allowed in and, jubianchi\\PPC\\Parser\\Debugger given on the right side\.$#'
			identifier: logicalAnd.rightNotBoolean
			count: 2
			path: src/lib/Parser.php

		-
			message: '#^Only booleans are allowed in and, jubianchi\\PPC\\Parser\\Debugger\|null given on the left side\.$#'
			identifier: logicalAnd.leftNotBoolean
			count: 2
			path: src/lib/Parser.php

		-
			message: '#^Binary operation "\-" between float and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/lib/Parser/Debugger.php

		-
			message: '#^Property jubianchi\\PPC\\Parser\\Debugger\:\:\$starts with generic class SplObjectStorage does not specify its types\: TObject, TData$#'
			identifier: missingType.generics
			count: 1
			path: src/lib/Parser/Debugger.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\\Result\:\:result\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/lib/Parser/Result.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\\Result\\Failure\:\:result\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/lib/Parser/Result/Failure.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\\Result\\Skip\:\:__construct\(\) has parameter \$result with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/lib/Parser/Result/Skip.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\\Result\\Success\:\:__construct\(\) has parameter \$result with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/lib/Parser/Result/Success.php

		-
			message: '#^Method jubianchi\\PPC\\Parser\\Result\\Success\:\:result\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/lib/Parser/Result/Success.php

		-
			message: '#^Property jubianchi\\PPC\\Parser\\Result\\Success\:\:\$result has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/lib/Parser/Result/Success.php

		-
			message: '#^Cannot access offset int on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/mappers.php

		-
			message: '#^Casting to array something that''s already array\.$#'
			identifier: cast.useless
			count: 1
			path: src/mappers.php

		-
			message: '#^Function jubianchi\\PPC\\Mappers\\otherwise\(\) has parameter \$default with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/mappers.php

		-
			message: '#^Function jubianchi\\PPC\\Mappers\\value\(\) has parameter \$value with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/mappers.php

		-
			message: '#^Only iterables can be unpacked, mixed given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: src/mappers.php

		-
			message: '#^Parameter \#1 \$value of function count expects array\|Countable, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/mappers.php

		-
			message: '#^Parameter \#1 \.\.\.\$slices of closure expects jubianchi\\PPC\\Slice, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/mappers.php

		-
			message: '#^Possibly invalid array key type mixed\.$#'
			identifier: array.invalidKey
			count: 1
			path: src/mappers.php

		-
			message: '#^Parameter \#1 \$string of function strtoupper expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/unit/ParserTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: tests/unit/combinators/AltTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: tests/unit/combinators/EnclosedTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: tests/unit/parsers/AnyTest.php
