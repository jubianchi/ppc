<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" timeoutForSmallTests="1" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="PPC">
      <directory>tests/unit</directory>
    </testsuite>
    <testsuite name="Documentation">
      <directory>tests/docs</directory>
    </testsuite>
  </testsuites>
  <logging>
    <junit outputFile="tmp/junit.xml"/>
  </logging>
  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>
